# ============================================================
# LEXORA — .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
*.pyo

# ---- Virtual Environments ----
.venv/
venv/
env/
ENV/
.env

# ---- Environment Variables (SENSITIVE — NEVER COMMIT) ----
backend/.env
.env.local
.env.production

# ---- Database ----
*.db
*.sqlite3
*.sql

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
logs/

# ---- Node / Frontend ----
node_modules/
.npm
.pnp

# ---- Build artifacts ----
/dist
/build
*.min.js.map

# ---- Test & Coverage ----
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---- Jupyter Notebook ----
.ipynb_checkpoints

# ---- Misc ----
*.bak
*.tmp
